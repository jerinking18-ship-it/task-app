{
  "name": "task-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "check:supabase": "node --env-file=.env.local scripts/check-supabase.mjs",
    "test:supabase": "node --test scripts/supabase-foundation.test.mjs",
    "test:auth": "node --test scripts/auth-flow.test.mjs",
    "test:tasks": "node --test scripts/tasks.test.mjs",
    "test:members": "node --test scripts/members.test.mjs",
    "test:bin": "node --test scripts/bin.test.mjs",
    "test:completed": "node --test scripts/completed.test.mjs",
    "test:sync": "node --test scripts/live-sync.test.mjs",
    "test:templates": "node --test scripts/templates.test.mjs",
    "test:history": "node --test scripts/member-history.test.mjs",
    "test:workspace": "node --test scripts/workspace.test.mjs",
    "test:workspace:sql": "python3 supabase/tests/workspace_assignments.py",
    "test:absence": "node --test scripts/absence.test.mjs",
    "test:absence:sql": "python3 supabase/tests/absence_coverage.py",
    "test:fines": "node --test scripts/fines.test.mjs",
    "test:fines:sql": "python3 supabase/tests/meeting_fines.py"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
