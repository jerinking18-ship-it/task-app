# Copy to .env.local and use your project's public connection settings.
# Never use a Supabase database password or privileged API key in the public fields.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only app settings. Use the exact local origin, including its port.
APP_ORIGIN=http://127.0.0.1:3003
# Generate a random value of at least 32 characters; never use a Supabase key.
AUTH_RECOVERY_SECRET=replace_with_a_random_server_only_secret
